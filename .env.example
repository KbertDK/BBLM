# Copy this file to .env (one per environment/checkout — see SERVER_SETUP.md)
# and fill in real values. Never commit the real .env file.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME"

# Signs/verifies the coach session JWT. Generate a unique one per environment with:
#   PowerShell:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
#   bash:        openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"

NODE_ENV=production
PORT=3000

# Powers the auto-generated post-match news recap (lib/recap.ts). Free tier key
# from https://aistudio.google.com — optional: if unset, match completion just
# skips generating a recap (no error shown to coaches).
GEMINI_API_KEY="replace-with-a-gemini-api-key"
