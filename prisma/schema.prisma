generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RuleSet {
  id              String        @id @default(cuid())
  name            String
  startIncome     Int
  gameType        GameType
  status          RuleSetStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  numberOfPlayers Int           @default(16)
  pointsDraw      Int           @default(1)
  pointsLoss      Int           @default(0)
  pointsWin       Int           @default(3)
  leagues         League[]
  spirallingExpenseTiers SpirallingExpenseTier[]
}

model SpirallingExpenseTier {
  id                 String  @id @default(cuid())
  ruleSetId          String
  teamValueThreshold Int
  expenseAmount      Int
  ruleSet            RuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
}

model League {
  id             String    @id @default(cuid())
  name           String
  isHidden       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  ruleSetId      String?
  ruleSet        RuleSet?  @relation(fields: [ruleSetId], references: [id])
  matches        Match[]
  teams          Team[]
  seasons        Season[]
  primaryCoaches Coach[]   @relation("CoachPrimaryLeague")
}

model Season {
  id        String       @id @default(cuid())
  leagueId  String
  name      String
  season    Int
  status    SeasonStatus @default(PLANNING)
  createdAt DateTime     @default(now())
  league    League       @relation(fields: [leagueId], references: [id])
  divisions Division[]
  matches   Match[]
}

model Division {
  id          String       @id @default(cuid())
  name        String
  seasonId    String
  isHidden    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  season      Season       @relation(fields: [seasonId], references: [id])
  teams       Team[]
  tournaments Tournament[] @relation("DivisionToTournament")
}

model Tournament {
  id            String       @id @default(cuid())
  name          String
  crossDivision Boolean      @default(false)
  createdAt     DateTime     @default(now())
  divisions     Division[]   @relation("DivisionToTournament")
  matches       Match[]
  prizeAwards   PrizeAward[]
}

model Coach {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  passwordHash    String?
  role            CoachRole  @default(COACH)
  createdAt       DateTime   @default(now())
  isActive        Boolean    @default(true)
  address         String?
  alias           String?    @unique
  city            String?
  phone           String?
  zip             String?
  primaryLeagueId String?
  mfaSecret       String?
  mfaEnabled      Boolean    @default(false)
  newsPosts       NewsPost[]
  teams           Team[]
  primaryLeague   League?    @relation("CoachPrimaryLeague", fields: [primaryLeagueId], references: [id], onDelete: SetNull)
  resetTokens     PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  coachId   String
  coach     Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Race {
  id              String         @id @default(cuid())
  name            String         @unique
  rosterSource    String
  rerollPrice     Int
  hasApothecary   Boolean
  tier            String         @default("1")
  mdTier          MdTier         @relation(fields: [tier], references: [tier])
  playerTypes     PlayerType[]
  teams           Team[]
  mdStarPlayers   MdStarPlayer[] @relation("StarPlayerToRace")
}

model MdTier {
  id          String  @id @default(cuid())
  tier        String  @unique
  description String?
  races       Race[]
}

model PlayerType {
  id              String       @id @default(cuid())
  raceId          String
  name            String
  cost            Int
  maxCount        Int
  isJourneyman    Boolean      @default(false)
  ma              Int
  st              Int
  ag              Int
  av              Int
  skillRollDouble String
  skillRollNormal String
  race            Race         @relation(fields: [raceId], references: [id])
  teamPlayers     TeamPlayer[]
  startingSkills  Skill[]      @relation("PlayerTypeToSkill")
  matchMercs      MatchMerc[]
  matchJourneymen MatchJourneyman[]
}

model Skill {
  id               String         @id @default(cuid())
  skillId          Int            @unique
  name             String         @unique
  category         SkillCategory
  skillRule        String
  playerTypes      PlayerType[]   @relation("PlayerTypeToSkill")
  mdStarPlayers    MdStarPlayer[] @relation("StarPlayerToSkill")
  learnedByPlayers TeamPlayer[]   @relation("TeamPlayerLearnedSkill")
}

model Team {
  id               String       @id @default(cuid())
  name             String
  raceId           String
  coachId          String
  leagueId         String
  divisionId       String?
  wins             Int          @default(0)
  losses           Int          @default(0)
  draws            Int          @default(0)
  createdAt        DateTime     @default(now())
  apothecary       Boolean      @default(false)
  assistantCoaches Int          @default(0)
  cheerleaders     Int          @default(0)
  fanFactor        Int          @default(0)
  rerolls          Int          @default(0)
  treasury         Int          @default(0)
  isActive         Boolean      @default(true)
  logoUrl          String?
  awayMatches      Match[]      @relation("AwayTeam")
  homeMatches      Match[]      @relation("HomeTeam")
  coach            Coach        @relation(fields: [coachId], references: [id])
  division         Division?    @relation(fields: [divisionId], references: [id])
  league           League       @relation(fields: [leagueId], references: [id])
  race             Race         @relation(fields: [raceId], references: [id])
  players          TeamPlayer[]
  prizeAwards      PrizeAward[]
}

model TeamPlayer {
  id              String       @id @default(cuid())
  teamId          String
  playerTypeId    String
  number          Int
  createdAt       DateTime     @default(now())
  casualties      Int          @default(0)
  completePasses  Int          @default(0)
  interceptions   Int          @default(0)
  name            String?
  status          PlayerStatus @default(ACTIVE)
  touchdowns      Int          @default(0)
  mvp             Int          @default(0)
  nigglingInjuries Int         @default(0)
  ssp             Int          @default(0)
  value           Int          @default(0)
  teamGamesAtSack Int?
  maIncrease      Int          @default(0)
  stIncrease      Int          @default(0)
  agIncrease      Int          @default(0)
  avIncrease      Int          @default(0)
  playerType      PlayerType   @relation(fields: [playerTypeId], references: [id])
  team            Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  skillRolls      SkillRoll[]
  learnedSkills   Skill[]      @relation("TeamPlayerLearnedSkill")
  matchStats      MatchPlayerStat[]
  prizeAwards     PrizeAward[]
}

model MatchPlayerStat {
  id             String     @id @default(cuid())
  matchId        String
  teamPlayerId   String
  touchdowns     Int        @default(0)
  completePasses Int        @default(0)
  interceptions  Int        @default(0)
  casualties     Int        @default(0)
  mvp            Int        @default(0)
  ssp            Int        @default(0)
  createdAt      DateTime   @default(now())
  match          Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamPlayer     TeamPlayer @relation(fields: [teamPlayerId], references: [id], onDelete: Cascade)
}

model SkillRoll {
  id           String     @id @default(cuid())
  teamPlayerId String
  die1         Int
  die2         Int
  consumed     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  teamPlayer   TeamPlayer @relation(fields: [teamPlayerId], references: [id], onDelete: Cascade)
}

model Match {
  id           String      @id @default(cuid())
  leagueId     String
  homeTeamId   String
  awayTeamId   String
  scheduledAt  DateTime?
  status       MatchStatus @default(SCHEDULED)
  round        Int
  homeScore    Int?
  awayScore    Int?
  createdAt    DateTime    @default(now())
  tournamentId      String?
  seasonId          String?
  homeTeamValue     Int?
  awayTeamValue     Int?
  homeTeamFanFactor Int?
  awayTeamFanFactor Int?
  homeApothecaryUsed Boolean @default(false)
  awayApothecaryUsed Boolean @default(false)
  weatherMdMatchEventId String?
  homePettyCash Int @default(0)
  awayPettyCash Int @default(0)
  homeFans Int?
  awayFans Int?
  homeFame Int?
  awayFame Int?
  weather           MdMatchEvent?    @relation(fields: [weatherMdMatchEventId], references: [id])
  awayTeam          Team             @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeTeam          Team             @relation("HomeTeam", fields: [homeTeamId], references: [id])
  league            League           @relation(fields: [leagueId], references: [id])
  tournament        Tournament?      @relation(fields: [tournamentId], references: [id])
  season            Season?          @relation(fields: [seasonId], references: [id])
  events            MatchEvent[]
  mercs             MatchMerc[]
  starPlayers       MatchStarPlayer[]
  journeymen        MatchJourneyman[]
  inducements       MatchInducement[]
  matchPlayerStats  MatchPlayerStat[]
  specialPlayCards  MatchSpecialPlayCard[]
  newsPost          NewsPost?
}

model MdSpecialPlayDeck {
  id    String @id @default(cuid())
  name  String @unique
  price Int
  cards MdSpecialPlayCard[]
  draws MatchSpecialPlayCard[]
}

model MdSpecialPlayCard {
  id          String @id @default(cuid())
  deckId      String
  cardLabel   String
  name        String
  description String
  timing      String
  effect      String
  deck        MdSpecialPlayDeck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  draws       MatchSpecialPlayCard[]

  @@unique([deckId, cardLabel])
}

model MatchSpecialPlayCard {
  id        String   @id @default(cuid())
  matchId   String
  side      String
  deckId    String
  cost      Int
  cardId    String?
  turn      Int?
  createdAt DateTime @default(now())
  match     Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  deck      MdSpecialPlayDeck  @relation(fields: [deckId], references: [id])
  card      MdSpecialPlayCard? @relation(fields: [cardId], references: [id])
}

model MatchStarPlayer {
  id           String       @id @default(cuid())
  matchId      String
  side         String
  starPlayerId String
  price        Int
  isCompanion  Boolean      @default(false)
  mvp          Int          @default(0)
  createdAt    DateTime     @default(now())
  match        Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  starPlayer   MdStarPlayer @relation(fields: [starPlayerId], references: [id])
}

model MatchMerc {
  id           String     @id @default(cuid())
  matchId      String
  side         String
  playerTypeId String
  cost         Int
  mvp          Int        @default(0)
  createdAt    DateTime   @default(now())
  match        Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerType   PlayerType @relation(fields: [playerTypeId], references: [id])
}

model MatchJourneyman {
  id             String       @id @default(cuid())
  matchId        String
  side           String
  playerTypeId   String
  number         Int?
  touchdowns     Int          @default(0)
  completePasses Int          @default(0)
  interceptions  Int          @default(0)
  casualties     Int          @default(0)
  mvp            Int          @default(0)
  ssp            Int          @default(0)
  injuryStatus   PlayerStatus @default(ACTIVE)
  resolved       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  match          Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerType     PlayerType   @relation(fields: [playerTypeId], references: [id])
}

model MdInducement {
  id        String @id @default(cuid())
  name      String @unique
  maxCount  Int
  price     Int
  rule      String
  createdAt DateTime @default(now())
  matches   MatchInducement[]
}

model MatchInducement {
  id            String       @id @default(cuid())
  matchId       String
  side          String
  inducementId  String
  cost          Int
  used          Boolean      @default(false)
  chefHalf1Used Boolean      @default(false)
  chefHalf2Used Boolean      @default(false)
  createdAt     DateTime     @default(now())
  match         Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  inducement    MdInducement @relation(fields: [inducementId], references: [id])
}

model MatchEvent {
  id             String        @id @default(cuid())
  matchId        String
  type           String
  label          String
  createdAt      DateTime      @default(now())
  scoringTeam    String?
  mdMatchEventId String?
  match          Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  mdMatchEvent   MdMatchEvent? @relation(fields: [mdMatchEventId], references: [id])
}

model MdMatchEvent {
  id             String       @id @default(cuid())
  name           String
  causesCasualty Boolean      @default(false)
  description    String?
  dieRoll        Int?
  eventType      String
  ssp            Int?
  createdAt      DateTime     @default(now())
  matchEvents    MatchEvent[]
  matches        Match[]
}

model MdStarPlayer {
  id             String         @id @default(cuid())
  name           String         @unique
  price          Int?
  includedWithId String?
  ma             Int
  st             Int
  ag             Int
  av             Int
  notes           String?
  createdAt       DateTime          @default(now())
  includedWith    MdStarPlayer?     @relation("StarPlayerCompanion", fields: [includedWithId], references: [id])
  companions      MdStarPlayer[]    @relation("StarPlayerCompanion")
  skills          Skill[]           @relation("StarPlayerToSkill")
  races           Race[]            @relation("StarPlayerToRace")
  matchStarPlayers MatchStarPlayer[]
}

model NewsPost {
  id        String   @id @default(cuid())
  title     String
  body      String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  coachNote String   @default("")
  playerId  String?
  teamId    String?
  matchId   String?  @unique
  author    Coach    @relation(fields: [authorId], references: [id])
  match     Match?   @relation(fields: [matchId], references: [id])
}

enum CoachRole {
  ADMIN
  COMMISH
  COACH
}

enum SeasonStatus {
  PLANNING
  READY
  ACTIVE
  ENDED
}

enum GameType {
  BLOOD_BOWL
  DUNGEON_BOWL
  BB7
}

enum RuleSetStatus {
  ACTIVE
  INACTIVE
}

enum SkillCategory {
  G
  A
  P
  S
  M
  E
}

enum PlayerStatus {
  ACTIVE
  MNG
  DEAD
  SACKED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
}

enum PrizeTargetType {
  TEAM
  PLAYER
}

enum PrizeStatus {
  ACTIVE
  INACTIVE
}

model PrizeType {
  id        String          @id @default(cuid())
  name      String
  type      PrizeTargetType
  status    PrizeStatus     @default(ACTIVE)
  icon      String          @default("")
  createdAt DateTime        @default(now())
  awards    PrizeAward[]
}

model PrizeAward {
  id           String      @id @default(cuid())
  prizeTypeId  String
  tournamentId String
  teamId       String?
  teamPlayerId String?
  createdAt    DateTime    @default(now())
  prizeType    PrizeType   @relation(fields: [prizeTypeId], references: [id])
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team?       @relation(fields: [teamId], references: [id])
  teamPlayer   TeamPlayer? @relation(fields: [teamPlayerId], references: [id])
}
